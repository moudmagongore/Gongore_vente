rules_version = '2';

// =========================================================================
// Règles de sécurité Firestore — Gongoré Vente (multi-tenant)
//
// Hiérarchie :
//   • superAdmin  → accès total (créé manuellement dans Firestore)
//   • admin       → admin d'une boutique (boutiqueId requis)
//   • vendeur     → vendeur d'une boutique (boutiqueId requis)
//
// À publier dans la console Firebase :
//   Firestore Database → Rules → coller → Publish
// =========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ================== Helpers ==================

    function isAuthed() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthed()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().active == true;
    }

    function isSuperAdmin() {
      return isActive() && userDoc().role == 'superAdmin';
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'admin';
    }

    function isVendeur() {
      return isActive() && userDoc().role == 'vendeur';
    }

    function userBoutiqueId() {
      return userDoc().boutiqueId;
    }

    function ownsBoutique(bid) {
      return (isAdmin() || isVendeur()) && userBoutiqueId() == bid;
    }

    // Le doc créé porte le bon boutiqueId
    function createBoutiqueIdMatches() {
      return request.resource.data.boutiqueId == userBoutiqueId();
    }

    // Le doc lu/modifié porte le bon boutiqueId
    function resourceBoutiqueIdMatches() {
      return resource.data.boutiqueId == userBoutiqueId();
    }

    // Empêche de modifier le boutiqueId à l'update
    function boutiqueIdNotChanged() {
      return request.resource.data.boutiqueId == resource.data.boutiqueId;
    }

    // ================== Users ==================
    match /users/{userId} {
      // Lecture :
      //   • superAdmin : tous
      //   • soi-même : son propre doc
      //   • tout user actif de la boutique : les users de sa boutique
      //     (nécessaire pour afficher noms vendeurs/admins dans listes
      //     ventes, règlements, etc.)
      allow read: if isSuperAdmin()
                  || (isAuthed() && request.auth.uid == userId)
                  || (isActive() && resource.data.boutiqueId == userBoutiqueId());

      // Création :
      //   • superAdmin : tous (admins ou vendeurs)
      //   • admin de boutique : uniquement vendeurs de SA boutique
      //   • personne ne peut créer un superAdmin via l'API
      allow create: if (isSuperAdmin()
                        && request.resource.data.role != 'superAdmin')
                    || (isAdmin()
                        && request.resource.data.role == 'vendeur'
                        && createBoutiqueIdMatches());

      // Update :
      //   • superAdmin : tout sauf promouvoir vers superAdmin
      //   • admin : uniquement vendeurs de sa boutique, sans changer rôle/boutique
      //   • soi-même : limité (nom, téléphone) — non couvert ici, simple deny
      allow update: if (isSuperAdmin()
                        && request.resource.data.role != 'superAdmin')
                    || (isAdmin()
                        && resource.data.role == 'vendeur'
                        && resource.data.boutiqueId == userBoutiqueId()
                        && request.resource.data.role == 'vendeur'
                        && boutiqueIdNotChanged());

      // Delete :
      //   • superAdmin : tous
      //   • admin : ses vendeurs
      allow delete: if isSuperAdmin()
                    || (isAdmin()
                        && resource.data.role == 'vendeur'
                        && resource.data.boutiqueId == userBoutiqueId());
    }

    // ================== Boutiques ==================
    match /boutiques/{bid} {
      // Lecture : super-admin tout, admin/vendeur uniquement sa boutique
      allow read: if isSuperAdmin() || (isAuthed() && ownsBoutique(bid));

      // Création/suppression : super-admin uniquement
      allow create: if isSuperAdmin();
      allow delete: if isSuperAdmin();

      // Update : super-admin tout, admin sa boutique
      allow update: if isSuperAdmin() || (isAdmin() && ownsBoutique(bid));
    }

    // ================== Catégories (par boutique) ==================
    match /categories/{cid} {
      allow read: if isSuperAdmin()
                  || (isAuthed() && resource.data.boutiqueId == userBoutiqueId());

      allow create: if isSuperAdmin()
                    || (isAdmin() && createBoutiqueIdMatches());

      allow update: if isSuperAdmin()
                    || (isAdmin()
                        && resourceBoutiqueIdMatches()
                        && boutiqueIdNotChanged());

      allow delete: if isSuperAdmin()
                    || (isAdmin() && resourceBoutiqueIdMatches());
    }

    // ================== Produits (par boutique) ==================
    match /produits/{pid} {
      allow read: if isSuperAdmin()
                  || (isAuthed() && resource.data.boutiqueId == userBoutiqueId());

      allow create: if isSuperAdmin()
                    || (isAdmin() && createBoutiqueIdMatches());

      allow update: if isSuperAdmin()
                    || (isAdmin()
                        && resourceBoutiqueIdMatches()
                        && boutiqueIdNotChanged());

      allow delete: if isSuperAdmin()
                    || (isAdmin() && resourceBoutiqueIdMatches());
    }

    // ================== Ventes ==================
    match /ventes/{vid} {
      allow read: if isSuperAdmin()
                  || (isAuthed() && resource.data.boutiqueId == userBoutiqueId());

      // Création par tout user de la boutique (admin OU vendeur).
      allow create: if isSuperAdmin()
                    || (isAuthed() && createBoutiqueIdMatches());

      // Update :
      //   • super-admin : tout
      //   • admin de la boutique : tout (notamment annulation)
      //   • tout user actif de la boutique :
      //       - le champ `montantPaye` (imputation FIFO d'un règlement)
      //       - l'annulation : passer `statut` à 'annulee' + `motifAnnulation`
      //         (le vendeur peut corriger une erreur de saisie ; le stock
      //         est restitué dans la même transaction).
      allow update: if isSuperAdmin()
                    || (isAdmin()
                        && resourceBoutiqueIdMatches()
                        && boutiqueIdNotChanged())
                    || (isActive()
                        && resourceBoutiqueIdMatches()
                        && request.resource.data.diff(resource.data)
                            .affectedKeys().hasOnly(['montantPaye']))
                    || (isActive()
                        && resourceBoutiqueIdMatches()
                        && resource.data.statut == 'validee'
                        && request.resource.data.statut == 'annulee'
                        && request.resource.data.diff(resource.data)
                            .affectedKeys()
                            .hasOnly(['statut', 'motifAnnulation']));

      // Delete réservé super-admin.
      allow delete: if isSuperAdmin();
    }

    // ================== Clients ==================
    match /clients/{cid} {
      allow read: if isSuperAdmin()
                  || (isAuthed() && resource.data.boutiqueId == userBoutiqueId());

      allow create: if isSuperAdmin()
                    || (isAuthed() && createBoutiqueIdMatches());

      allow update: if isSuperAdmin()
                    || (isAuthed()
                        && resourceBoutiqueIdMatches()
                        && boutiqueIdNotChanged());

      // Suppression : super-admin (toujours), ou tout user actif de la
      // boutique uniquement si le client n'a JAMAIS eu d'opération
      // (drapeau dénormalisé `hasOperations`, posé à `true` à la
      // première vente ou règlement par les transactions correspondantes).
      // Une fois flaggé, le client devient indélébile côté serveur.
      // NB: les clients existants en base sans le champ retombent sur
      // `false` par défaut (rétro-compat) ; à leur prochaine opération
      // ils seront flaggés.
      allow delete: if isSuperAdmin()
                    || (isActive()
                        && resourceBoutiqueIdMatches()
                        && resource.data.get('hasOperations', false) != true);
    }

    // ================== Règlements (encaissements) ==================
    // Tout user de la boutique peut lire/créer un règlement (vendeur en caisse,
    // admin pour gestion). La création décrémente le solde du client lié
    // dans la même transaction.
    match /reglements/{rid} {
      allow read: if isSuperAdmin()
                  || (isAuthed() && resource.data.boutiqueId == userBoutiqueId());

      allow create: if isSuperAdmin()
                    || (isAuthed() && createBoutiqueIdMatches());

      // Pas d'update (immuable). Suppression réservée admin/super-admin
      // (la méthode deleteAndRestore restitue le montant au solde).
      allow update: if isSuperAdmin();

      allow delete: if isSuperAdmin()
                    || (isAdmin() && resourceBoutiqueIdMatches());
    }

    // ================== Compteurs (numéros de vente séquentiels) ==================
    // Document ID = boutiqueId. Champs `ventes{ANNEE}` incrémentés à chaque
    // création de vente dans la même transaction.
    match /counters/{cid} {
      // Lecture/écriture par tout user lié à cette boutique.
      // L'ID du document EST le boutiqueId, donc on compare au boutiqueId user.
      allow read, create, update: if isSuperAdmin()
                                  || (isAuthed() && cid == userBoutiqueId());

      // Pas de delete possible (audit trail).
      allow delete: if isSuperAdmin();
    }

    // ================== Tout le reste : refusé ==================
    // Sécurité par défaut : deny all sur les chemins non couverts ci-dessus.
  }
}
